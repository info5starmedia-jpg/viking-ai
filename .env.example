# Viking AI Drop Catcher — Environment Variables
# Copy this file to /opt/viking-ai/.env and fill in your values.
# Lines starting with # are comments. Never commit your real .env file.

# ── Discord ──────────────────────────────────────────────────────────────────
DISCORD_TOKEN=                        # REQUIRED — Bot token from Discord Developer Portal

# Default channel for drop alerts (Discord channel ID as integer)
DEFAULT_CHANNEL_ID=

# Drop catcher alerts
DROP_CATCHER_CHANNEL_ID=             # Channel ID for TM drop alerts
DROP_CATCHER_WEBHOOK_URL=            # Discord webhook URL (https://discord.com/api/webhooks/...)
DROP_PING_ROLE_ID=                   # Role ID to ping on new drops

# Platform monitor alerts (SeatGeek / StubHub / VividSeats)
PRICE_ALERT_CHANNEL_ID=              # Channel ID for platform price alerts

# Tour scan alerts
TOUR_SCAN_ALERT_CHANNEL_ID=          # Channel ID for tour announcements

# Verified fan alerts
VERIFIED_FAN_ALERT_CHANNEL_ID=       # Channel ID for Verified Fan announcements

# TM surge watch alerts
TM_SURGE_CHANNEL_ID=                 # Channel ID for TM surge/inventory alerts

# ── Ticketmaster ─────────────────────────────────────────────────────────────
TICKETMASTER_API_KEY=                 # REQUIRED for drop catcher & tour scan
TM_API_KEY=                          # Alias for TICKETMASTER_API_KEY (fallback)

# ── SeatGeek ─────────────────────────────────────────────────────────────────
SEATGEEK_CLIENT_ID=                  # SeatGeek API client ID (enables API-mode polling)
SEATGEEK_CLIENT_SECRET=              # SeatGeek API client secret (optional)

# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_WEBHOOK_SECRET=               # REQUIRED for Stripe webhooks (whsec_...)
STRIPE_STARTER_PRICE_ID=             # Stripe Price ID for Starter tier ($80/mo)
STRIPE_PRO_PRICE_ID=                 # Stripe Price ID for Pro tier ($100/mo)
STRIPE_UNLIMITED_PRICE_ID=           # Stripe Price ID for Unlimited tier ($300/mo)

# ── Dashboard (Flask) ────────────────────────────────────────────────────────
DASHBOARD_SECRET_KEY=                # REQUIRED in prod — random secret for Flask sessions
DASHBOARD_PORT=5000                  # Port for Flask dashboard (default 5000)

# Discord OAuth (for dashboard login)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://yourdomain.com/auth/discord/callback

# Google OAuth (optional dashboard login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://yourdomain.com/auth/google/callback

# ── Drop Catcher Tuning ───────────────────────────────────────────────────────
DROP_CATCHER_POLL_SECONDS=60         # How often to poll TM for drops (default 60)
DROP_GLOBAL_SCAN_ENABLED=1           # Enable global TM scan (0 to disable)
DROP_DIGEST_ENABLED=1                # Enable daily digest post (0 to disable)
DROP_DIGEST_HOUR_UTC=12              # Hour (UTC) to post daily digest (default 12)

# ── Platform Monitor Tuning ───────────────────────────────────────────────────
PLATFORM_POLL_SECONDS=300            # SeatGeek/StubHub/VividSeats poll interval (default 300)
PLATFORM_PRICE_DROP_PCT=5            # Minimum % price drop to fire alert (default 5)
PLATFORM_PRICE_SPIKE_PCT=20          # Minimum % price spike to fire alert (default 20)

# ── AI / External APIs ────────────────────────────────────────────────────────
OPENAI_API_KEY=                      # OpenAI API key (used by AI agents)
GOOGLE_API_KEY=                      # Google API key (used by agents)
TAVILY_API_KEY=                      # Tavily search API key
CANVA_API_KEY=                       # Canva API key (optional)
ELEVENLABS_API_KEY=                  # ElevenLabs voice API key (optional)

# ── Proxies (optional) ────────────────────────────────────────────────────────
# Comma-separated list of proxies in host:port or user:pass@host:port format.
# Used by drop_catcher and platform_monitor to rotate requests.
PROXY_LIST=
